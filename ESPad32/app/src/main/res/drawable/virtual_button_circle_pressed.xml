<?xml version="1.0" encoding="utf-8"?>
<!--
    Pressed-state twin of virtual_button_circle.xml — same oval shape,
    solid brighter fill instead of just a thin outline, so the "pressed"
    visual feedback stays circular. The previous approach swapped to
    setBackgroundColor() on press, which always draws a plain rectangle
    regardless of the shape it's replacing — that's what caused the
    square flash on an otherwise circular button.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#8000E5FF"/>
    <stroke android:width="1.5dp" android:color="#00E5FF"/>
</shape>
