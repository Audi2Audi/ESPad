<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A0A0A"/>
            <stroke android:width="2dp" android:color="#D82F2E"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#001A1A"/>
            <stroke android:width="2dp" android:color="#00E5FF"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A"/>
            <stroke android:width="1dp" android:color="#00E5FF"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</selector>
