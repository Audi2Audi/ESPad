<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ESPad32Controller" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="CarButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_car_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">4dp</item>
    </style>

    <!-- Genuine edge-to-edge dialog presentation, matching how
         ControllerMappingActivity fills the screen — the default
         dialog theme keeps floating-window chrome (dim border, rounded
         corners) even when resized to MATCH_PARENT dimensions, so this
         explicitly strips that out instead. -->
    <style name="FullscreenDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
