<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0A0A0A"
    android:fitsSystemWindows="true">

    <!-- Fixed header -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📡  OTA Firmware Update"
        android:textColor="#00E5FF" android:textSize="18sp" android:textStyle="bold"
        android:padding="20dp" android:paddingBottom="4dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Compile in Arduino IDE → Sketch → Export Compiled Binary (.bin), then select it here."
        android:textColor="#666666" android:textSize="12sp"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp"/>

    <!-- Scrollable content -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="20dp" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/tvOtaStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Checking ESP32…" android:textColor="#888888"
                android:textSize="14sp" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tvOtaInfo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#555555"
                android:textSize="11sp" android:fontFamily="monospace"
                android:layout_marginBottom="20dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#333333" android:layout_marginBottom="20dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="STEP 1 — Select firmware .bin file"
                android:textColor="#666666" android:textSize="10sp"
                android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
            <Button android:id="@+id/btnPickBin"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="📂  Browse for custom .bin file"
                android:textSize="14sp" style="@style/CarButton"
                android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Or restore the bundled default firmware below"
                android:textColor="#555555" android:textSize="10sp"
                android:layout_marginBottom="12dp"/>
            <Button android:id="@+id/btnFlashDefault"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="⭐  Flash Default Firmware"
                android:textSize="14sp" style="@style/CarButton"
                android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tvDefaultBoardSupport"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#8A939C" android:textSize="10sp"
                android:layout_marginBottom="24dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="STEP 2 — Upload to ESP32"
                android:textColor="#666666" android:textSize="10sp"
                android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
            <Button android:id="@+id/btnFlash"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="⚡  Flash Firmware"
                android:textSize="14sp" style="@style/CarButton"
                android:layout_marginBottom="20dp"/>

            <ProgressBar android:id="@+id/otaProgressBar"
                android:layout_width="match_parent" android:layout_height="20dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:progressTint="#00E5FF"
                android:layout_marginBottom="10dp"/>
            <TextView android:id="@+id/tvOtaProgress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#00E5FF" android:textSize="12sp"
                android:fontFamily="monospace" android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="⚠  Keep the app open and stay connected to the ESP32 during flashing."
                android:textColor="#554400" android:textSize="11sp"
                android:background="#221A00" android:padding="12dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed back button -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#333333"/>
    <Button android:id="@+id/btnOtaBack"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="← Back" android:textSize="13sp"
        android:layout_margin="12dp"
        style="@style/CarButton"/>

</LinearLayout>
