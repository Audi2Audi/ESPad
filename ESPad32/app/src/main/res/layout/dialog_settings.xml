<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:fitsSystemWindows="true">

    <!-- Header — matches Controller Mapping's style for visual
         consistency. Also functionally necessary now that this screen
         fills the whole display: previously the dialog only took up
         ~95%/80% of the screen, so tapping the visible area outside it
         was how you'd dismiss it. Filling the screen removes that
         "outside" area entirely, so an explicit Close button is the
         real dismiss affordance now (back gesture still works too). -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#1A1A1A"
        android:padding="12dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="⚙  Settings"
            android:textColor="#00E5FF" android:textSize="16sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnSettingsClose"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:text="✕ Close" android:textSize="12sp" style="@style/CarButton"/>
    </LinearLayout>

    <!-- Top bar: IP + Joystick toggle -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#1A1A1A"
        android:padding="10dp" android:gravity="center_vertical">

        <!-- IP address - extends further right -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="IP" android:textColor="#666666" android:textSize="11sp"
            android:layout_marginEnd="6dp"/>
        <EditText android:id="@+id/etIpAddress"
            android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:inputType="text" android:fontFamily="monospace"
            android:textColor="#FFFFFF" android:textColorHint="#555555"
            android:hint="192.168.4.1" android:background="@drawable/edittext_underline"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- Search for devices on the network — solves the "STA IP
             wasn't reported in time during the AP->STA channel switch"
             problem by asking the device directly via UDP broadcast
             instead of relying on the earlier TCP response. -->
        <Button android:id="@+id/btnSearchDevices"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="🔍" android:textSize="14sp"
            android:layout_marginEnd="16dp"
            style="@style/CarButton"/>

        <!-- Joystick toggle — Follow/Track (Freenove-specific
             CMD_CAR_MODE light-follow/line-track sensor modes) removed
             from here, same reasoning as the main panel cleanup: this
             sketch has no sensors to back those modes. -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Joysticks" android:textColor="#888888"
            android:textSize="10sp" android:layout_marginEnd="6dp"/>
        <Switch android:id="@+id/switchJoysticks"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:thumbTint="#00E5FF" android:trackTint="#333333"/>

    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#333333"/>

    <!-- Body: sidebar tabs + content -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">

        <!-- Left sidebar tabs -->
        <LinearLayout android:layout_width="110dp" android:layout_height="match_parent"
            android:orientation="vertical" android:background="#111111">
            <TextView android:id="@+id/tabWifi"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="📶  WiFi" android:textSize="12sp"
                android:padding="14dp" android:textColor="#00E5FF"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222"/>
            <TextView android:id="@+id/tabTheme"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🎨  Theme" android:textSize="12sp"
                android:padding="14dp" android:textColor="#888888"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222"/>
            <TextView android:id="@+id/tabController"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🎮  Controller" android:textSize="12sp"
                android:padding="14dp" android:textColor="#888888"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222"/>
            <TextView android:id="@+id/tabAdvanced"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="📡  OTA" android:textSize="12sp"
                android:padding="14dp" android:textColor="#888888"/>
        </LinearLayout>

        <!-- Right content area -->
        <ScrollView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="14dp"
            android:background="#0A0A0A">
            <LinearLayout android:id="@+id/settingsContent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>

    <!-- No bottom Save/Close bar — every setting now applies and
         persists immediately when changed (see persistSettings() in
         SettingsDialogFragment.kt), and closing the dialog any way
         (back gesture, tap outside) already reliably saved everything
         via onDismiss() even before this change. Save/Close were
         functionally identical to each other and to just closing the
         dialog normally — removed rather than kept as redundant UI. -->

</LinearLayout>
