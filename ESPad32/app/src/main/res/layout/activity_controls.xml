<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_controls.xml

    Same visual language as activity_pin_mapper.xml (dark background,
    amber accent) for consistency between the two screens.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1215">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Profile switcher -->
        <LinearLayout
            android:id="@+id/controlsProfileTabContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#181D23"
            android:padding="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUTTONS"
            android:textColor="#5F6A73"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/buttonListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No buttons yet. Tap &quot;Add Button&quot; below — only pins mapped as a digital output (like an LED) can back a button right now."
            android:textColor="#5F6A73"
            android:textSize="12sp"
            android:padding="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/addButtonBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Button"
            android:backgroundTint="#E3A458"
            android:textColor="#1A1408"
            android:layout_marginTop="12dp" />

        <!-- Log console -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOG"
            android:textColor="#4A525A"
            android:textSize="10sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/controlsLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#9AA4AD"
            android:background="#0B0D10"
            android:padding="10dp" />

    </LinearLayout>
</ScrollView>
