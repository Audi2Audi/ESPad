<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="#1A1A1A"
    android:padding="12dp" android:layout_marginBottom="4dp"
    android:gravity="center_vertical">
    <TextView android:id="@+id/tvButtonName"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="#CCCCCC" android:textSize="13sp"/>
    <TextView android:id="@+id/tvButtonFunction"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="#00E5FF"
        android:textSize="12sp" android:gravity="end"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text=" ›" android:textColor="#555555" android:textSize="16sp"/>
</LinearLayout>
