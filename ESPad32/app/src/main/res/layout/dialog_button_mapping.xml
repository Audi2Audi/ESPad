<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#1A1A1A" android:padding="20dp">

    <TextView android:id="@+id/tvMappingTarget"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#00E5FF" android:textSize="14sp" android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Assign function:" android:textColor="#888888"
        android:textSize="11sp" android:layout_marginBottom="6dp"/>
    <Spinner android:id="@+id/spinnerFunction"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:backgroundTint="#00E5FF" android:popupBackground="#1A1A1A"
        android:layout_marginBottom="16dp"/>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#333333" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="— or —" android:textColor="#555555"
        android:gravity="center" android:layout_marginBottom="12dp"/>

    <Button android:id="@+id/btnDetect"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="🎮  Detect Button (press on controller)"
        android:textSize="12sp" style="@style/CarButton"/>
</LinearLayout>
