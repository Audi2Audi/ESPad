<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="#1A1A1A"
    android:padding="14dp" android:layout_marginBottom="8dp"
    android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvPresetName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvPresetDesc"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#888888" android:textSize="11sp"/>
    </LinearLayout>
    <Button android:id="@+id/btnApplyPreset"
        android:layout_width="80dp" android:layout_height="36dp"
        android:text="Apply" android:textSize="12sp" style="@style/CarButton"/>
</LinearLayout>
