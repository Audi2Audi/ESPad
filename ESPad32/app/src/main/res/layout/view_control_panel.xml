<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="8dp"
    android:paddingEnd="52dp">

    <!-- Was a row of Photo/Record/View Log/Camera Flip/Settings icon
         buttons here — removed as genuine duplication, not just
         simplified for its own sake: Photo/Record/Settings already
         exist as compact icons in cameraControls (activity_main.xml),
         Camera Flip was added there too, and View Log moved into
         Settings' Theme tab (a diagnostic action, not something that
         needs to be a quick-access icon). This view's only remaining
         job is the live Controls buttons below, populated by
         MainActivity at runtime — auto-hide/tap-to-show still applies
         to this whole view exactly as before, unchanged. -->

    <!-- Rows of user-configured Control buttons (from the Controls screen)
         get added here at runtime by MainActivity — empty by default. -->
    <LinearLayout android:id="@+id/dynamicButtonsContainer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"/>

</LinearLayout>
