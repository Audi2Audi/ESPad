<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="8dp"
    android:paddingEnd="52dp">

    <!-- Photo + Record + Log + Flip + Settings.
         LED/Face/Horn/Servo Reset/Custom Face removed — those sent
         CMD_LED_MOD / CMD_MATRIX_MOD / CMD_BUZZER / CMD_CAMERA commands
         specific to the original Freenove-based car firmware, which
         lives in a separate, untouched repo (ESPad32) and doesn't apply
         to devices built for this project (train, custom RC car, etc).
         Camera Flip is kept since it only flips the local video feed
         orientation — no device command involved. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnPhoto" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="📸" android:textSize="14sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnRecord" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="⏺" android:textSize="14sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnViewLog" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="📋" android:textSize="14sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnCameraFlip" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="🔄 Flip" android:textSize="11sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnSettings" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="⚙" android:textSize="14sp" style="@style/CarButton"/>
    </LinearLayout>

    <!-- Rows of user-configured Control buttons (from the Controls screen)
         get added here at runtime by MainActivity — empty by default. -->
    <LinearLayout android:id="@+id/dynamicButtonsContainer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"/>

</LinearLayout>
