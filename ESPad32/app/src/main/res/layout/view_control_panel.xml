<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="8dp"
    android:paddingEnd="52dp">

    <!-- Row 1: Drive modes -->
    <!-- Row 1: LEDs + Emotion -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnLedCycle" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="🌈 LED" android:textSize="11sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnLedOff" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="⬛ LED Off" android:textSize="11sp"
            android:layout_marginEnd="8dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnEmotionCycle" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="😊 Face" android:textSize="11sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnEmotionOff" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="⬛ Face Off" android:textSize="11sp" style="@style/CarButton"/>
    </LinearLayout>

    <!-- Row 3: Horn + Servo + Camera flip -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="6dp">
        <ToggleButton android:id="@+id/btnBuzzer" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:textOn="📯 ON" android:textOff="📯 Horn"
            android:textSize="11sp" android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnServoReset" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="🎯 Reset" android:textSize="11sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnCameraFlip" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="🔄 Flip" android:textSize="11sp" style="@style/CarButton"/>
    </LinearLayout>

    <!-- Row 4: Photo + Record + Log + Matrix + Settings
         (Settings moved to rightmost = right thumb, Matrix one left) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnPhoto" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="📸" android:textSize="14sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnRecord" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="⏺" android:textSize="14sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnViewLog" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="📋" android:textSize="14sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnMatrixCanvas" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="🤓 CUSTOM FACE" android:textSize="10sp"
            android:layout_marginEnd="4dp" style="@style/CarButton"/>
        <Button android:id="@+id/btnSettings" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1"
            android:text="⚙" android:textSize="14sp" style="@style/CarButton"/>
    </LinearLayout>

    <!-- Rows of user-configured Control buttons (from the Controls screen)
         get added here at runtime by MainActivity — empty by default. -->
    <LinearLayout android:id="@+id/dynamicButtonsContainer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"/>

</LinearLayout>
