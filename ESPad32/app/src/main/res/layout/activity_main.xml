<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Camera surface fills entire screen -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Logo shown when camera not connected. Top is constrained to the status bar's
         bottom (not the screen edge) and bottom to the control panel's top, so the
         logo centers in the visible space between them and never touches either. -->
    <LinearLayout
        android:id="@+id/cameraPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@mipmap/ic_launcher_round"
            android:alpha="0.6"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESPad32"
            android:textColor="#666666"
            android:textSize="16sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Status bar overlay — sits below system status bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#AA000000"
        android:paddingTop="28dp"
        android:paddingBottom="6dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvIp"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="---.---.---.---"
            android:textColor="#00E5FF" android:textSize="12sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tvStatus"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Disconnected"
            android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        <TextView android:id="@+id/tvBattery"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🔋 --V"
            android:textColor="#69FF47" android:textSize="12sp" android:gravity="end"/>
    </LinearLayout>

    <!-- REC indicator — below system status bar -->
    <TextView android:id="@+id/tvRecording"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FF4444" android:textSize="14sp"
        android:textStyle="bold" android:paddingTop="28dp" android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ESP32 battery widget — top right, below status bar, left of nav bar -->
    <LinearLayout
        android:id="@+id/esp32BattWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/tvEspBattery"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="░░░░░ --%"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="monospace"/>
        <TextView android:id="@+id/tvEspBattLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ESP32"
            android:textColor="#888888"
            android:textSize="9sp"
            android:gravity="center"
            android:layout_marginEnd="12dp"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- Left joystick — drive, bottom left -->
    <com.espad32.controller.JoystickView
        android:id="@+id/joystickLeft"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="gone"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"/>

    <!-- Right joystick — pan/tilt, bottom right but left of camera overlay -->
    <com.espad32.controller.JoystickView
        android:id="@+id/joystickRight"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="gone"
        android:layout_marginEnd="140dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"/>

    <!-- Camera + settings overlay — bottom right, shown when menu hidden, fades with menu -->
    <LinearLayout
        android:id="@+id/cameraControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#AA000000"
        android:padding="8dp"
        android:alpha="0"
        android:visibility="invisible"
        android:layout_marginEnd="52dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnPhotoOverlay"
            android:layout_width="52dp" android:layout_height="52dp"
            android:text="📸" android:textSize="22sp"
            android:background="@drawable/btn_car_bg"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnRecordOverlay"
            android:layout_width="52dp" android:layout_height="52dp"
            android:text="⏺" android:textSize="22sp"
            android:background="@drawable/btn_car_bg"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnSettingsOverlay"
            android:layout_width="52dp" android:layout_height="52dp"
            android:text="⚙" android:textSize="22sp"
            android:background="@drawable/btn_car_bg"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnPinMapperOverlay"
            android:layout_width="52dp" android:layout_height="52dp"
            android:text="📌" android:textSize="22sp"
            android:background="@drawable/btn_car_bg"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnControlsOverlay"
            android:layout_width="52dp" android:layout_height="52dp"
            android:text="🔘" android:textSize="22sp"
            android:background="@drawable/btn_car_bg"/>
    </LinearLayout>

    <!-- Live Control buttons (from Controls screen) — middle-left, clear of
         both joysticks (bottom) and the camera/settings overlay (bottom-right) -->
    <LinearLayout
        android:id="@+id/liveButtonsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintBottom_toTopOf="@id/joystickLeft"
        app:layout_constraintVertical_bias="0.5"/>

    <!-- Control panel — bottom, auto-hides -->
    <com.espad32.controller.ControlPanelView
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
